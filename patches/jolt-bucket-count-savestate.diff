diff --git a/Jolt/Physics/Constraints/ContactConstraintManager.cpp b/Jolt/Physics/Constraints/ContactConstraintManager.cpp
index 7de3a448..bf03695d 100644
--- a/Jolt/Physics/Constraints/ContactConstraintManager.cpp
+++ b/Jolt/Physics/Constraints/ContactConstraintManager.cpp
@@ -417,6 +417,24 @@ void ContactConstraintManager::ManifoldCache::SaveState(StateRecorder &inStream,
 {
 	JPH_ASSERT(mIsFinalized);
 
+	// Save the cache's hash-map bucket counts. Without this, a peer
+	// that restores into a fresh engine ends up with a different
+	// bucket count than the saving peer (driven by Init/Prepare
+	// history, not by current contents), which puts identical
+	// (body-pair, manifold) entries into different hash buckets ->
+	// different iteration order during the next step's solver pass
+	// -> non-deterministic floating-point sums -> ~1e-3 velocity
+	// drift on the next step (visible as hash-level peer-diverged
+	// in browser-side multiplayer rollback). The receiving side's
+	// RestoreState reads these and SetNumBuckets to match before
+	// creating entries.
+	{
+		uint32 bp = mCachedBodyPairs.GetNumBuckets();
+		uint32 mf = mCachedManifolds.GetNumBuckets();
+		inStream.Write(bp);
+		inStream.Write(mf);
+	}
+
 	// Get contents of cache
 	Array<const BPKeyValue *> all_bp;
 	GetAllBodyPairsSorted(all_bp);
@@ -502,6 +520,23 @@ bool ContactConstraintManager::ManifoldCache::RestoreState(const ManifoldCache &
 
 	bool success = true;
 
+	// Read the saving peer's hash-map bucket counts and set ours to
+	// match BEFORE creating any entries. The receiving cache is
+	// guaranteed clear here (Restore is called on the write buffer
+	// at the start of a restore; it gets populated then swapped to
+	// become the read buffer). Without this, entries land in
+	// different hash buckets on the saver vs the receiver, causing
+	// non-deterministic iteration order and ~1e-3 velocity drift
+	// on the next step. See matching SaveState above.
+	{
+		uint32 bp = mCachedBodyPairs.GetNumBuckets();
+		uint32 mf = mCachedManifolds.GetNumBuckets();
+		inStream.Read(bp);
+		inStream.Read(mf);
+		mCachedBodyPairs.SetNumBuckets(bp);
+		mCachedManifolds.SetNumBuckets(mf);
+	}
+
 	// Create a contact allocator for restoring the contact cache
 	ContactAllocator contact_allocator(GetContactAllocator());
 
@@ -661,6 +696,24 @@ bool ContactConstraintManager::ManifoldCache::RestoreState(const ManifoldCache &
 	return success;
 }
 
+void ContactConstraintManager::ManifoldCache::SaveBucketCounts(StateRecorder &inStream) const
+{
+	uint32 bp = mCachedBodyPairs.GetNumBuckets();
+	uint32 mf = mCachedManifolds.GetNumBuckets();
+	inStream.Write(bp);
+	inStream.Write(mf);
+}
+
+void ContactConstraintManager::ManifoldCache::RestoreBucketCounts(StateRecorder &inStream)
+{
+	uint32 bp = 0;
+	uint32 mf = 0;
+	inStream.Read(bp);
+	inStream.Read(mf);
+	mCachedBodyPairs.SetNumBuckets(bp);
+	mCachedManifolds.SetNumBuckets(mf);
+}
+
 ////////////////////////////////////////////////////////////////////////////////////////////////////////
 // ContactConstraintManager
 ////////////////////////////////////////////////////////////////////////////////////////////////////////
@@ -1784,7 +1837,23 @@ void ContactConstraintManager::FinishConstraintBuffer()
 
 void ContactConstraintManager::SaveState(StateRecorder &inStream, const StateRecorderFilter *inFilter) const
 {
+	// The read buffer (used for lookups during the next step,
+	// contains the just-finished step's manifolds + read-side
+	// bucket counts via ManifoldCache::SaveState above).
 	mCache[mCacheWriteIdx ^ 1].SaveState(inStream, inFilter);
+
+	// Also save the WRITE buffer's hash-map bucket counts. The write
+	// buffer is empty at this point (Cleared + Prepare'd at the end
+	// of FinalizeContactCacheAndCallContactPointRemovedCallbacks
+	// with last frame's contact counts -> typically clamped to
+	// cMinBuckets=1024), but its bucket count is what the next step
+	// will hash NEW manifold writes into. On a freshly Init'd engine
+	// the write buffer's bucket count is GetNextPowerOf2(maxBodyPairs)
+	// (e.g. 4096), so without persisting this, joiner and host land
+	// identical manifold writes in different buckets next step ->
+	// different in-bucket iteration order -> ~1e-3 velocity drift,
+	// even though the read-side bytes are bit-identical.
+	mCache[mCacheWriteIdx].SaveBucketCounts(inStream);
 }
 
 bool ContactConstraintManager::RestoreState(StateRecorder &inStream, const StateRecorderFilter *inFilter)
@@ -1796,6 +1865,12 @@ bool ContactConstraintManager::RestoreState(StateRecorder &inStream, const State
 	{
 		mCacheWriteIdx ^= 1;
 		mCache[mCacheWriteIdx].Clear();
+
+		// Apply the host's write-buffer bucket counts to our new
+		// (just-cleared) write buffer. This ensures the next step's
+		// manifold writes hash into the same buckets on both peers.
+		// See matching SaveState above.
+		mCache[mCacheWriteIdx].RestoreBucketCounts(inStream);
 	}
 
 	return success;
